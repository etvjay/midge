# The playground service's environment, in the form the Phala deploy step reads (see docs/PLAYGROUND_RUNBOOK.md). Copy this file to
# ~/.midge-phala/playground.env, which is outside the repository, and fill it in there. Never put a filled-in copy anywhere in the repository.
# Nothing here is a real value.

# ---- Secrets. They go to the machine as encrypted environment variables and are never written into a compose file or an image. ----
# The dedicated funding account `play.<main account>` and its OWN key, made by `node scripts/playground-funder.mjs --fund 6`. This must never be the deployer key
# or any key that owns the contract: a testnet funding key is the only thing the service should be able to spend.
FUNDER_ID=play.your-account.testnet
FUNDER_KEY=ed25519:REPLACE_ME
# The key the room's admin routes need. Choose a long random value, and give the same value to the room machine as ROOST_ADMIN_KEY.
ROOM_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
NEARAI_API_KEY=REPLACE_ME
# Lets the service wake and stop the room machine. It can also delete machines, so keep it to this one purpose and rotate it after judging.
PHALA_CLOUD_API_KEY=REPLACE_ME

# The private NEAR testnet endpoint (it carries an API key in its address) and the list the service checks keys against. Use the same private address in the room's
# ROOST_PRIVATE_RPC_URL (see deploy/roost/room.env.example). Without these the service falls back to the free public endpoints, which rate limit.
NEAR_RPC_URL=https://REPLACE-private-endpoint.example/REPLACE_KEY
NEAR_RPC_URLS=https://REPLACE-private-endpoint.example/REPLACE_KEY,https://near-testnet.drpc.org

# ---- Not secret, but specific to your deployment ----
# The public address of the room machine, and its Phala id (so the service can wake it).
ROOM_URL=https://REPLACE-8080.dstack-pha1-prod5.phala.network
ROOM_CVM_ID=REPLACE_ME
# The one website origin that may call the service from a browser, for example the site's address with no trailing slash.
PLAYGROUND_ORIGIN=https://midge.vercel.app

# ---- Optional limits (these are the defaults in the compose file) ----
# PLAYGROUND_PER_DAY=60
# PLAYGROUND_PER_ADDRESS=6
# PLAYGROUND_PROXY_HOPS=1
# PLAYGROUND_FUNDER_FLOOR_NEAR=2
