# The room machine's encrypted environment, in the form the Phala deploy step reads. Copy to ~/.midge-phala/room.env (outside the repository, mode 600).
# Nothing here is a real value.

# The key the room's admin routes need. The playground service holds the same value as ROOM_ADMIN_KEY.
ROOST_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
# A private NEAR testnet endpoint. It carries an API key in its address, so it is an encrypted variable and is never written into the compose file.
ROOST_PRIVATE_RPC_URL=https://REPLACE-private-endpoint.example/REPLACE_KEY
