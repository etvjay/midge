# Midge environment. Copy this file to .env and fill in the values you need. .env is ignored by git and must never be committed.
# Nothing in this file is a real value. Every key here belongs to NEAR testnet or to a paid service, and none of them should ever be reused elsewhere.
#
# What needs what:
#   npm ci && ./scripts/verify        needs none of this. It runs offline and spends nothing.
#   node lab/run.js --tier testnet    needs the NEAR section (and NEARAI_API_KEY for the experiments that call the model).
#   node lab/run.js --tier hardware   needs the NEAR, NEAR AI and Phala sections, plus Docker and the dcap-qvl tool.
#   the playground service            has its own file: deploy/playground/playground.env.example (and it must not use the deployer key).

# ---- NEAR testnet (testnet only) ----
# The main account that creates and funds the accounts a lab experiment uses. The key signs transactions, so treat it as a secret even on testnet.
NEAR_ACCOUNT_ID=your-account.testnet
NEAR_PRIVATE_KEY=ed25519:REPLACE_ME
# Optional. The default is the public testnet RPC. LAB_NEAR_RPC overrides it for lab runs only.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# LAB_NEAR_RPC=https://test.rpc.fastnear.com
# NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com
# NEAR_NETWORK=testnet
# The contract to talk to. Optional: a client that holds an account derives c.<account> by default.
# COORDINATOR_ID=c.your-account.testnet

# ---- NEAR AI Cloud (the model that reviews pay runs, and the attested inference checks) ----
NEARAI_API_KEY=REPLACE_ME
# Optional. A JSON pin of accepted model hardware measurements (see src/enclave/attestation.js).
# MIDGE_MODEL_MEASUREMENTS={}

# ---- Phala Cloud (the hardware room) ----
# Needed to deploy, stop, start and delete the hosted room. Treat it as a secret: it can delete machines.
PHALA_CLOUD_API_KEY=REPLACE_ME
# Optional. The path to the dcap-qvl binary, if it is not on the PATH, for checking a hardware quote.
# DCAP_QVL_BIN=/usr/local/bin/dcap-qvl

# ---- Other chains (only for the multichain experiments) ----
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---- Where the chain client reads credentials from ----
# The NEAR chain client does not read .env on its own. Pass credentials in the environment, or point it at a file explicitly.
# MIDGE_ENV_FILE=/absolute/path/to/a/private/env/file
