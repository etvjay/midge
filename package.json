{
  "name": "fly-syndicate-network",
  "version": "0.1.0",
  "description": "Fly: A Syndicate Network for Private Systems on NEAR Protocol",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "fly-mcp": "./bin/fly-mcp.js"
  },
  "scripts": {
    "verify": "./scripts/verify",
    "test": "node verify-all.js",
    "demo:syndicate": "node src/simulation/runner.js",
    "start:daemon": "node -e 'import(\"./src/api/server.js\").then(m => new m.FlyApiDaemon({ port: 3000 }).start().then(s => console.log(\"Fly Daemon live on port \" + s.port)))'",
    "verify:tee": "node verifications/01-hardware-attestation.js",
    "verify:intents": "node verifications/02-confidential-intents.js",
    "verify:hatch": "node verifications/03-hatch-escape-hatch.js",
    "verify:vault": "node verifications/04-dark-vault-epochs.js",
    "verify:rfq": "node verifications/05-confidential-rfq-adjudication.js",
    "verify:otc": "node verifications/06-otc-and-compute-facilities.js",
    "verify:matrix": "node verifications/07-resilience-failure-matrix.js",
    "verify:api": "node verifications/08-api-sse-mcp-e2e.js",
    "verify:rust": "cd contracts/fly-coordinator && cargo test",
    "verify:testnet": "node scripts/testnet-e2e.js",
    "verify:mpc": "node scripts/testnet-mpc.js",
    "build:wasm": "cd contracts/fly-coordinator && cargo build --target wasm32-unknown-unknown --release",
    "check:foundry": "node scripts/check-foundry.js",
    "review:argon": "node scripts/argon-review.js"
  },
  "keywords": [
    "near",
    "privacy",
    "tee",
    "syndicate",
    "pod",
    "agents",
    "confidential-intents",
    "chain-signatures",
    "rfq",
    "mcp",
    "x402"
  ],
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.17.0",
    "near-api-js": "^7.4.0"
  }
}
