{
  "name": "midge",
  "version": "0.1.0",
  "description": "Midge: A Syndicate Network for Private Systems on NEAR Protocol",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "midge-mcp": "./bin/midge-mcp.js"
  },
  "scripts": {
    "verify": "./scripts/verify",
    "test": "node verify-all.js",
    "demo": "node scripts/demo.js",
    "demo:syndicate": "node src/simulation/runner.js",
    "demo:network": "node scripts/network-demo.js",
    "start:daemon": "node -e 'import(\"./src/api/server.js\").then(m => new m.FlyApiDaemon({ port: 3000 }).start().then(s => console.log(\"Midge Daemon live on port \" + s.port)))'",
    "verify:tee": "node verifications/01-hardware-attestation.js",
    "verify:intents": "node verifications/02-confidential-intents.js",
    "verify:hatch": "node verifications/03-hatch-escape-hatch.js",
    "verify:vault": "node verifications/04-dark-vault-epochs.js",
    "verify:rfq": "node verifications/05-confidential-rfq-adjudication.js",
    "verify:otc": "node verifications/06-otc-and-compute-facilities.js",
    "verify:matrix": "node verifications/07-resilience-failure-matrix.js",
    "verify:api": "node verifications/08-api-sse-mcp-e2e.js",
    "verify:rust": "cd contracts/fly-coordinator && cargo test",
    "verify:testnet": "node scripts/testnet-e2e.js",
    "verify:onchain": "node scripts/verify-onchain.js",
    "verify:mpc": "node scripts/testnet-mpc.js",
    "verify:inference": "node scripts/verify-inference.js",
    "verify:roost-model": "node scripts/verify-roost-model.js",
    "verify:roost-sealed": "node verifications/09-model-sealed-roost.js",
    "verify:roost-hosted": "node verifications/10-hosted-roost.js",
    "verify:hosted-attestation": "node scripts/verify-hosted-roost.js",
    "build:wasm": "cd contracts/fly-coordinator && RUSTFLAGS=\"-C link-arg=-s\" cargo build --target wasm32-unknown-unknown --release",
    "baseline": "node scripts/baseline.js",
    "security:review": "node scripts/security-review.js",
    "check:foundry": "node scripts/check-foundry.js",
    "review:argon": "node scripts/argon-review.js"
  },
  "keywords": [
    "near",
    "privacy",
    "tee",
    "syndicate",
    "pod",
    "agents",
    "confidential-intents",
    "chain-signatures",
    "rfq",
    "mcp",
    "x402"
  ],
  "license": "MIT",
  "dependencies": {
    "@nearai/inference-sdk": "^0.1.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "ethers": "^6.17.0",
    "near-api-js": "^7.4.0"
  }
}
